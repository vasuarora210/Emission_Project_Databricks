   "source": [
    "select state_abbr, \n",
    "  sum(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) as Total_Emission\n",
    "from emissinon.default.emissions_data\n",
    "group by state_abbr\n",
    "order by Total_Emission desc\n",
    "limit 10"
   ]
  }
