{
  "datasets": [
    {
      "name": "002d350f",
      "displayName": "Location data",
      "queryLines": [
        "select latitude,longitude,\r\n",
        "`GHG emissions mtons CO2e` as Emissions\r\n",
        "from emissinon.default.emissions_data"
      ]
    },
    {
      "name": "dd1c8ada",
      "displayName": "Emissions per person",
      "queryLines": [
        "select county_state_name, population,\r\n",
        "  (CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / population) as Emissions_per_person\r\n",
        "from emissinon.default.emissions_data\r\n",
        "order by emissions_per_person desc"
      ],
      "catalog": "emissinon",
      "schema": "default"
    },
    {
      "name": "7681537c",
      "displayName": "Total Emission per state",
      "queryLines": [
        "select state_abbr, \r\n",
        "  sum(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) as Total_Emission\r\n",
        "from emissinon.default.emissions_data\r\n",
        "group by state_abbr\r\n",
        "order by Total_Emission desc\r\n",
        "limit 10"
      ],
      "catalog": "emissinon",
      "schema": "default"
    },
    {
      "name": "730c19ff",
      "displayName": "Country Shaming",
      "queryLines": [
        "select county_state_name, population,\r\n",
        "  (CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) as Total_Emissions\r\n",
        "from emissinon.default.emissions_data\r\n",
        "order by total_emissions desc\r\n",
        "limit 10"
      ],
      "catalog": "emissinon",
      "schema": "default"
    }
  ],
